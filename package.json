{
  "name": "best-react-pagination",
  "version": "0.2.0",
  "description": "Accessible pagination for React",
  "type": "module",
  "main": "./dist/pagination.cjs",
  "module": "./dist/pagination.js",
  "types": "./dist/pagination.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/pagination.d.ts",
        "default": "./dist/pagination.js"
      },
      "require": {
        "types": "./dist/pagination.d.cts",
        "default": "./dist/pagination.cjs"
      }
    },
    "./styles.css": {
      "types": "./dist/styles.css.d.ts",
      "default": "./dist/styles.css"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json && node scripts/finalize-build.mjs",
    "build:demo": "vite build demo",
    "dev": "vite demo",
    "start": "npm run dev",
    "lint": "eslint lib demo/src e2e vite.lib.config.ts playwright.config.ts",
    "lint:write": "npm run lint -- --fix",
    "prettier": "prettier --write lib demo/src",
    "typecheck": "tsc",
    "test": "npm run build && node --test \"test/*.test.mjs\"",
    "test:a11y": "playwright test",
    "test:pack": "node scripts/verify-package.mjs",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/97Dmitry/best-react-pagination.git"
  },
  "author": "Dmitry Tsybizov",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/97Dmitry/best-react-pagination/issues"
  },
  "homepage": "https://github.com/97Dmitry/best-react-pagination#readme",
  "peerDependencies": {
    "react": ">=16.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.15.0",
    "prettier": "^3.6.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8"
  }
}
